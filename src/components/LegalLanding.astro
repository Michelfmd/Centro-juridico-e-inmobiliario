---
import BaseLayout from "../layouts/BaseLayout.astro";
import { legalContent } from "../data/legalContent";

interface Props {
	variant?: "moderna";
}

const variant = Astro.props.variant ?? "moderna";
const whatsappUrl = "https://wa.me/5213325789151";
const emailUrl = "mailto:sanchezchaviraabogado@gmail.com";
const title = `Abogado en Guadalajara | ${legalContent.name}`;
const description =
	`${legalContent.name}, ${legalContent.credentials}. Estrategia y acompañamiento jurídico en sucesiones, asuntos inmobiliarios y derecho corporativo.`;
---

<BaseLayout title={title} description={description}>
	<div class={`landing landing--${variant}`}>
		<header class="landing-header">
			<div class="container landing-header__inner">
				<a class="brand" href={`/demo/${variant}/`} aria-label={`Inicio | ${legalContent.name}`}>
					<span class="brand__name">{legalContent.name}</span>
					<span class="brand__role">Servicios legales</span>
				</a>
				<nav class="landing-nav" aria-label="Navegación principal">
					<a href="#servicios">Servicios</a>
					<a href="#perfil">Perfil</a>
					<a href="#experiencia">Experiencia</a>
					<a href="#contacto">Contacto</a>
				</nav>
			</div>
		</header>

		<main id="contenido">
			<section class="landing-hero" id="inicio" aria-labelledby="hero-title">
				<div class="container landing-hero__grid">
					<div class="landing-hero__content">
						<p class="eyebrow">Estrategia legal para decisiones importantes</p>
						<h1 id="hero-title">Certeza jurídica para decisiones importantes.</h1>
						<p class="hero-lead">
							Le ayudamos a ordenar su situación, anticipar riesgos y avanzar con una estrategia clara
							en sucesiones, patrimonio, operaciones inmobiliarias y asuntos corporativos.
						</p>
						<div class="button-group" aria-label="Opciones de contacto">
							<a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								Agendar una primera conversación
							</a>
							<a class="button button--secondary" href={emailUrl}>Enviar correo</a>
						</div>
					</div>
				</div>
			</section>

			<section class="landing-section services-section" id="servicios" aria-labelledby="services-title">
				<div class="container">
					<div class="section-intro">
						<p class="eyebrow">Áreas de práctica</p>
						<h2 id="services-title">La estrategia correcta empieza por entender el problema completo.</h2>
						<p>
							Analizamos su caso, identificamos el camino más conveniente y le explicamos sus opciones
							con franqueza, lenguaje claro y visión de largo plazo.
						</p>
					</div>
					<div class="service-grid">
						{
							legalContent.areas.map((area, index) => (
								<article class="service-card">
									<span class="service-card__index" aria-hidden="true">0{index + 1}</span>
									<h3>{area.title}</h3>
									<p>{area.description}</p>
								</article>
							))
						}
					</div>
					<div class="notarial-services">
						<div class="notarial-services__intro">
							<p class="eyebrow">Formalización de operaciones</p>
							<h3>Del acuerdo a los documentos que le dan seguridad.</h3>
							<p class="notarial-services__note">
								Revisamos la operación, sus antecedentes y la documentación necesaria para preparar
								su formalización ante la instancia que corresponda.
							</p>
						</div>
						<ul class="notarial-services__list">
							{
								legalContent.notarialServices.map((service) => (
									<li>
										<strong>{service.title}</strong>
										<span>{service.description}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="landing-section profile-section" id="perfil" aria-labelledby="profile-title">
				<div class="container profile-grid">
					<div>
						<p class="eyebrow">Perfil profesional</p>
						<h2 id="profile-title">El respaldo que necesita para tomar decisiones con seguridad.</h2>
					</div>
					<div class="profile-copy">
						<p class="profile-credentials">{legalContent.credentials}.</p>
						<p>
							Cada asunto merece una lectura cuidadosa. Revisamos los hechos, la documentación y los
							objetivos que quiere proteger para construir una ruta jurídica ordenada y realista.
						</p>
						<p>
							La atención es directa, confidencial y enfocada en que usted entienda qué puede hacer,
							qué riesgos existen y cuál es el siguiente paso más conveniente para su caso.
						</p>
						<figure class="profile-portrait">
							<img
								src="/images/francisco-javier-sanchez-chavira-perfil.jpeg"
								alt="Francisco Javier Sánchez Chavira en un entorno profesional"
								width="639"
								height="846"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Fotografía profesional</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="landing-section experience-section" id="experiencia" aria-labelledby="experience-title">
				<div class="container experience-panel">
					<div>
						<p class="eyebrow">Experiencia en asuntos</p>
						<h2 id="experience-title">Visión jurídica para proteger su patrimonio y sus decisiones.</h2>
					</div>
					<p>
						Con experiencia en sucesiones, operaciones inmobiliarias y formalización de actos jurídicos,
						abordamos cada asunto con rigor, criterio práctico y atención a los detalles que pueden hacer
						la diferencia.
					</p>
				</div>
			</section>

			<section class="landing-section reach-section" aria-labelledby="reach-title">
				<div class="container reach-panel">
					<div>
						<p class="eyebrow">Trámites notariales en Guadalajara</p>
						<h2 id="reach-title">Su ubicación no debe ser un obstáculo para formalizar sus asuntos.</h2>
					</div>
					<p>
						Si se encuentra fuera de Guadalajara, podemos orientarle y acompañarle en la preparación y
						coordinación de trámites notariales que deban realizarse en la ciudad. Revisamos su situación,
						documentación y objetivos para ayudarle a avanzar con claridad, sin importar desde dónde nos
						contacte.
					</p>
				</div>
			</section>

			<section class="landing-section contact-section" id="contacto" aria-labelledby="contact-title">
				<div class="container contact-panel">
					<div>
						<p class="eyebrow">Contacto</p>
						<h2 id="contact-title">El siguiente paso es hablar de su caso.</h2>
					</div>
					<div class="contact-placeholder">
						<p class="contact-placeholder__label">Conversemos con confidencialidad</p>
						<p>Escríbanos por WhatsApp o correo. Cuéntenos brevemente qué necesita proteger y le responderemos para coordinar una primera conversación.</p>
						<div class="button-group button-group--contact" aria-label="Contacto directo">
							<a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								WhatsApp
							</a>
							<a class="button button--secondary" href={emailUrl}>Correo electrónico</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="landing-footer">
			<div class="container landing-footer__inner">
				<p>{legalContent.name}</p>
				<p>La información de este sitio es general y no sustituye una consulta jurídica personalizada.</p>
			</div>
		</footer>

		<a
			class="whatsapp-float"
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contactar por WhatsApp"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.56 0 .25 5.3.25 11.82c0 2.08.54 4.1 1.57 5.88L.18 23.98l6.42-1.68a11.8 11.8 0 0 0 5.47 1.35h.01c6.52 0 11.82-5.3 11.82-11.82 0-3.16-1.22-6.13-3.4-8.33Zm-8.42 18.1h-.01a9.78 9.78 0 0 1-4.98-1.36l-.36-.21-3.81 1 1.02-3.72-.23-.38a9.8 9.8 0 0 1-1.5-5.11C2.21 6.4 6.64 1.98 12.08 1.98a9.75 9.75 0 0 1 6.95 2.88 9.75 9.75 0 0 1 2.87 6.96c0 5.44-4.43 9.78-9.82 9.78Zm5.37-7.33c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.28-.47-2.44-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z" />
			</svg>
		</a>
	</div>
</BaseLayout>
