---
import BaseLayout from "../layouts/BaseLayout.astro";
import { legalContent } from "../data/legalContent";

const whatsappUrl = "https://wa.me/5213325789151";
const emailUrl = "mailto:sanchezchaviraabogado@gmail.com";
const title = `${legalContent.name} en Guadalajara`;
const description =
	`${legalContent.name}, ${legalContent.credentials}. Servicios jurídicos en sucesiones, servicios notariales, registro civil, asuntos inmobiliarios y empresas.`;
---

<BaseLayout title={title} description={description}>
	<div class="landing landing--moderna">
		<header class="landing-header">
			<div class="container landing-header__inner">
				<a class="brand" href="/" aria-label={`Inicio | ${legalContent.name}`}>
					<img
						class="brand__logo"
						src="/images/logo.jpeg"
						alt=""
						width="72"
						height="72"
						decoding="async"
					/>
					<span class="brand__text">
						<span class="brand__name">{legalContent.name}</span>
						<span class="brand__role">Servicios legales</span>
					</span>
				</a>
				<nav class="landing-nav" aria-label="Navegación principal">
					<a href="#servicios">Servicios</a>
					<a href="#perfil">Perfil</a>
					<a href="#experiencia">Experiencia</a>
					<a href="#contacto">Contacto</a>
				</nav>
			</div>
		</header>

		<main id="contenido">
			<section class="landing-hero" id="inicio" aria-labelledby="hero-title">
				<div class="container landing-hero__grid">
					<div class="landing-hero__content">
						<p class="eyebrow">Servicios jurídicos en Guadalajara</p>
						<h1 id="hero-title">Acompañamiento legal para resolver sus necesidades.</h1>
						<p class="hero-lead">
							Contáctenos para conocer su necesidad y brindarle orientación. Solicite su cotización,
							gratuita y sin compromiso.
						</p>
						<div class="button-group" aria-label="Opciones de contacto">
							<a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								Solicitar cotización
							</a>
							<a class="button button--secondary" href={emailUrl}>Enviar correo</a>
						</div>
					</div>
				</div>
			</section>

			<section class="landing-section services-section" id="servicios" aria-labelledby="services-title">
				<div class="container">
					<div class="section-intro">
						<p class="eyebrow">Nuestros servicios</p>
						<h2 id="services-title">Soluciones jurídicas para personas, familias y empresas.</h2>
						<p>
							Le orientamos en cada trámite y proceso con atención directa y acompañamiento profesional.
						</p>
					</div>
					<div class="service-grid">
						{
							legalContent.areas.map((area, index) => (
								<article class="service-card">
									<span class="service-card__index" aria-hidden="true">0{index + 1}</span>
									<h3>{area.title}</h3>
									<p>{area.description}</p>
									{area.pendingConfirmation && (
										<p class="service-card__note">{area.pendingConfirmation}</p>
									)}
									{area.stages && (
										<ol class="service-card__list">
											{area.stages.map((stage) => <li>{stage}</li>)}
										</ol>
									)}
									{area.items && (
										<ul class="service-card__list">
											{area.items.map((item) => <li>{item}</li>)}
										</ul>
									)}
									<a
										class="service-card__cta"
										href={`${whatsappUrl}?text=${encodeURIComponent(`Hola, quisiera orientación sobre ${area.title.toLowerCase()}.`)}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										{area.cta ?? "Consultar este servicio"} <span aria-hidden="true">→</span>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="landing-section profile-section" id="perfil" aria-labelledby="profile-title">
				<div class="container profile-grid">
					<div>
						<p class="eyebrow">Perfil profesional</p>
						<h2 id="profile-title">Experiencia y atención profesional.</h2>
					</div>
					<div class="profile-copy">
						<p class="profile-credentials">{legalContent.credentials}. {legalContent.experience}.</p>
						<p>
							Atendemos las necesidades de cada cliente con orientación clara y seguimiento de sus
							trámites.
						</p>
						<p>
							Contáctenos para conocer su necesidad y recibir una cotización gratuita y sin compromiso.
						</p>
					</div>
				</div>
			</section>

			<section class="landing-section experience-section" id="experiencia" aria-labelledby="experience-title">
				<div class="container experience-panel">
					<div>
						<p class="eyebrow">Experiencia profesional</p>
						<h2 id="experience-title">Acompañamiento jurídico con 15 años de experiencia.</h2>
					</div>
					<p>
						Maestría en Derecho Corporativo y experiencia en juicios sucesorios, servicios notariales,
						registro civil, servicios inmobiliarios y trámites para empresas.
					</p>
				</div>
			</section>

			<section class="landing-section reach-section" aria-labelledby="reach-title">
				<div class="container reach-panel">
					<div>
						<p class="eyebrow">Atención en la ZMG</p>
						<h2 id="reach-title">Trámites ante dependencias estatales y municipales.</h2>
					</div>
					<p>
						Realizamos trámites ante dependencias estatales y municipales en la Zona Metropolitana de
						Guadalajara, incluyendo licencias, permisos, notificaciones y entrega o recolección de
						documentación sensible.
					</p>
				</div>
			</section>

			<section class="landing-section contact-section" id="contacto" aria-labelledby="contact-title">
				<div class="container contact-panel">
					<div>
						<p class="eyebrow">Contacto</p>
						<h2 id="contact-title">Contáctenos para conocer su necesidad.</h2>
					</div>
					<div class="contact-placeholder">
						<p class="contact-placeholder__label">Solicite su cotización</p>
						<p>Escríbanos por WhatsApp o correo para recibir orientación y una cotización gratuita y sin compromiso.</p>
						<div class="button-group button-group--contact" aria-label="Contacto directo">
							<a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								WhatsApp
							</a>
							<a class="button button--secondary" href={emailUrl}>Correo electrónico</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="landing-footer">
			<div class="container landing-footer__inner">
				<p>{legalContent.name}</p>
				<p>La información de este sitio es general y no sustituye una consulta jurídica personalizada.</p>
			</div>
		</footer>

		<a
			class="whatsapp-float"
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contactar por WhatsApp"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.56 0 .25 5.3.25 11.82c0 2.08.54 4.1 1.57 5.88L.18 23.98l6.42-1.68a11.8 11.8 0 0 0 5.47 1.35h.01c6.52 0 11.82-5.3 11.82-11.82 0-3.16-1.22-6.13-3.4-8.33Zm-8.42 18.1h-.01a9.78 9.78 0 0 1-4.98-1.36l-.36-.21-3.81 1 1.02-3.72-.23-.38a9.8 9.8 0 0 1-1.5-5.11C2.21 6.4 6.64 1.98 12.08 1.98a9.75 9.75 0 0 1 6.95 2.88 9.75 9.75 0 0 1 2.87 6.96c0 5.44-4.43 9.78-9.82 9.78Zm5.37-7.33c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.28-.47-2.44-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z" />
			</svg>
		</a>
	</div>
</BaseLayout>
