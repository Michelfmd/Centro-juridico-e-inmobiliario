---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Sitio provisional | Servicios legales",
	description = "Página provisional para presentar los servicios de un abogado en México.",
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido principal</a>
		<slot />
	</body>
</html>
